# Copy to .env and fill in. Never commit the real .env.

# ---- AWS Bedrock (required) -----------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
LLM_MODEL=amazon.nova-lite-v1:0

# ---- FAQ cache (optional) -------------------------------------------
# Leave blank to run without PostgreSQL. Every question then goes straight
# to the RAG pipeline: slower and pricier, but fully functional.
DATABASE_URL=

# ---- Retrieval -------------------------------------------------------
TOP_K=3
FAQ_THRESHOLD=0.4

# ---- Web access ------------------------------------------------------
# Browser origins allowed to call this API directly, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000

# Must match BACKEND_SHARED_SECRET on the portfolio site.
# Leave blank locally to disable the check.
BACKEND_SHARED_SECRET=
